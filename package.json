{
  "name": "@nsupp/rest-sdk",
  "version": "0.1.0",
  "description": "Typed, dependency-free client for the nsupp /cof/v1 REST API — auth, envelope handling, website-scoped helpers. Node 18+ and browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asindie-dev/nsupp.git",
    "directory": "packages/rest-sdk"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nsupp",
    "rest",
    "api",
    "sdk",
    "support"
  ],
  "license": "Apache-2.0"
}
